rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow read: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);
    }

    match /connectionRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending'
        && (!('message' in request.resource.data)
          || (request.resource.data.message is string
            && request.resource.data.message.size() <= 180))
        && (!exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
          || !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.get('hiddenProfileIds', [])))
        && !isHiddenPair(request.auth.uid, request.resource.data.recipientId)
        && requestId == request.auth.uid + '_' + request.resource.data.recipientId;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /connectionChats/{connectionId}/messages/{messageId} {
      allow read: if isAcceptedConnection(connectionId);
      allow create: if isAcceptedConnection(connectionId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    match /presence/{userId} {
      allow read: if request.auth != null
        && (isOwner(userId) || isAcceptedPair(request.auth.uid, userId));
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['online', 'lastSeen'])
        && request.resource.data.online is bool
        && request.resource.data.lastSeen is timestamp;
      allow delete: if false;
    }

    match /hiddenUsers/{ownerId}/profiles/{otherId} {
      allow read: if isOwner(ownerId);
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['hiderId', 'hiddenId', 'updatedAt'])
        && request.resource.data.hiderId == request.auth.uid
        && request.resource.data.hiddenId != request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && ((ownerId == request.auth.uid && otherId == request.resource.data.hiddenId)
          || (ownerId == request.resource.data.hiddenId && otherId == request.auth.uid));
      allow delete: if request.auth != null
        && resource.data.hiderId == request.auth.uid
        && ((ownerId == request.auth.uid && otherId == resource.data.hiddenId)
          || (ownerId == resource.data.hiddenId && otherId == request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAcceptedConnection(connectionId) {
      let connection = get(/databases/$(database)/documents/connectionRequests/$(connectionId));
      return request.auth != null
        && connection.data.status == 'accepted'
        && (connection.data.senderId == request.auth.uid
          || connection.data.recipientId == request.auth.uid);
    }

    function isAcceptedPair(viewerId, otherId) {
      let outgoing = /databases/$(database)/documents/connectionRequests/$(viewerId + '_' + otherId);
      let incoming = /databases/$(database)/documents/connectionRequests/$(otherId + '_' + viewerId);
      return request.auth != null
        && ((exists(outgoing) && get(outgoing).data.status == 'accepted')
          || (exists(incoming) && get(incoming).data.status == 'accepted'));
    }

    function isHiddenPair(firstUserId, secondUserId) {
      return exists(/databases/$(database)/documents/hiddenUsers/$(firstUserId)/profiles/$(secondUserId))
        || exists(/databases/$(database)/documents/hiddenUsers/$(secondUserId)/profiles/$(firstUserId));
    }
  }
}
