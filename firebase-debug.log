[debug] [2026-08-18T19:26:15.928Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/unmasked-b62af/rulesets {"name":"projects/unmasked-b62af/rulesets/461cdd37-c4d0-48de-ac3b-fd2a44229590","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /users/{userId} {\n      allow create: if isOwner(userId)\n        && request.resource.data.uid == userId;\n      allow read: if isOwner(userId);\n      allow update: if isOwner(userId)\n        && request.resource.data.uid == resource.data.uid;\n      allow delete: if false;\n    }\n\n    match /profiles/{userId} {\n      allow read: if request.auth != null;\n      allow create: if isOwner(userId)\n        && request.resource.data.userId == userId;\n      allow update: if isOwner(userId)\n        && request.resource.data.userId == resource.data.userId;\n      allow delete: if isOwner(userId);\n    }\n\n    match /connectionRequests/{requestId} {\n      allow read: if request.auth != null\n        && (resource.data.senderId == request.auth.uid\n          || resource.data.recipientId == request.auth.uid);\n      allow create: if request.auth != null\n        && request.resource.data.senderId == request.auth.uid\n        && request.resource.data.recipientId != request.auth.uid\n        && request.resource.data.status == 'pending'\n        && (!('message' in request.resource.data)\n          || (request.resource.data.message is string\n            && request.resource.data.message.size() <= 180))\n        && (!exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))\n          || !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.get('hiddenProfileIds', [])))\n        && !isHiddenPair(request.auth.uid, request.resource.data.recipientId)\n        && requestId == request.auth.uid + '_' + request.resource.data.recipientId;\n      allow update: if request.auth != null\n        && resource.data.recipientId == request.auth.uid\n        && resource.data.status == 'pending'\n        && request.resource.data.status in ['accepted', 'declined']\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['status', 'updatedAt']);\n      allow delete: if false;\n    }\n\n    match /connectionChats/{connectionId}/messages/{messageId} {\n      allow read: if isAcceptedConnection(connectionId);\n      allow create: if isAcceptedConnection(connectionId)\n        && request.resource.data.senderId == request.auth.uid\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0\n        && request.resource.data.text.size() <= 1000;\n      allow update, delete: if false;\n    }\n\n    match /presence/{userId} {\n      allow read: if request.auth != null\n        && (isOwner(userId) || isAcceptedPair(request.auth.uid, userId));\n      allow create, update: if isOwner(userId)\n        && request.resource.data.keys().hasOnly(['online', 'lastSeen'])\n        && request.resource.data.online is bool\n        && request.resource.data.lastSeen is timestamp;\n      allow delete: if false;\n    }\n\n    match /hiddenPairs/{pairId} {\n      allow read: if request.auth != null\n        && request.auth.uid in resource.data.members;\n      allow create: if request.auth != null\n        && request.resource.data.keys().hasOnly(['hiderId', 'hiddenId', 'members', 'updatedAt'])\n        && request.resource.data.hiderId == request.auth.uid\n        && request.resource.data.hiddenId != request.auth.uid\n        && request.resource.data.members is list\n        && request.resource.data.members.size() == 2\n        && request.auth.uid in request.resource.data.members\n        && request.resource.data.hiddenId in request.resource.data.members\n        && request.resource.data.updatedAt is timestamp\n        && pairId in [\n          request.auth.uid + '_' + request.resource.data.hiddenId,\n          request.resource.data.hiddenId + '_' + request.auth.uid\n        ];\n      allow update: if request.auth != null\n        && resource.data.hiderId == request.auth.uid\n        && request.resource.data.hiderId == resource.data.hiderId\n        && request.resource.data.hiddenId == resource.data.hiddenId\n        && request.resource.data.members == resource.data.members\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);\n      allow delete: if request.auth != null\n        && resource.data.hiderId == request.auth.uid;\n    }\n\n    function isOwner(userId) {\n      return request.auth != null && request.auth.uid == userId;\n    }\n\n    function isAcceptedConnection(connectionId) {\n      let connection = get(/databases/$(database)/documents/connectionRequests/$(connectionId));\n      return request.auth != null\n        && connection.data.status == 'accepted'\n        && (connection.data.senderId == request.auth.uid\n          || connection.data.recipientId == request.auth.uid);\n    }\n\n    function isAcceptedPair(viewerId, otherId) {\n      let outgoing = /databases/$(database)/documents/connectionRequests/$(viewerId + '_' + otherId);\n      let incoming = /databases/$(database)/documents/connectionRequests/$(otherId + '_' + viewerId);\n      return request.auth != null\n        && ((exists(outgoing) && get(outgoing).data.status == 'accepted')\n          || (exists(incoming) && get(incoming).data.status == 'accepted'));\n    }\n\n    function isHiddenPair(firstUserId, secondUserId) {\n      return exists(/databases/$(database)/documents/hiddenPairs/$(firstUserId + '_' + secondUserId))\n        || exists(/databases/$(database)/documents/hiddenPairs/$(secondUserId + '_' + firstUserId));\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-18T19:26:15.883775Z","metadata":{"services":["cloud.firestore"]}}
